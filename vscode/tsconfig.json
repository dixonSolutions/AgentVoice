{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node", "vscode"],
    "paths": { "@agentvoice/client": ["../packages/client/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "../packages/client/src/**/*.ts"]
}
