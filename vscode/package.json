{
  "name": "agentvoice",
  "displayName": "AgentVoice",
  "description": "Desk client for the AgentVoice bridge: answer your coding agent's permission prompts, send editor context, follow its spoken replies with read-along shading, and review its edits — Cursor, Codex, Claude Code and Codewhale through one bridge.",
  "version": "0.1.2",
  "publisher": "dixonsolutions",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dixonSolutions/AgentVoice"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "agent",
    "voice",
    "claude code",
    "codex",
    "cursor",
    "mcp"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentvoice",
          "title": "AgentVoice",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentvoice": [
        {
          "id": "agentvoice.panel",
          "type": "webview",
          "name": "Agent",
          "contextualTitle": "AgentVoice"
        },
        {
          "id": "agentvoice.changes",
          "name": "Changes",
          "contextualTitle": "AgentVoice changes"
        },
        {
          "id": "agentvoice.sessions",
          "name": "Agents, jobs & sessions",
          "contextualTitle": "AgentVoice sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentvoice.changes",
        "contents": "No files touched by the agent yet in this session.\n[Refresh from git](command:agentvoice.refresh)"
      }
    ],
    "commands": [
      {
        "command": "agentvoice.connect",
        "title": "AgentVoice: Connect to bridge",
        "icon": "$(plug)"
      },
      {
        "command": "agentvoice.setToken",
        "title": "AgentVoice: Set bridge token"
      },
      {
        "command": "agentvoice.openPanel",
        "title": "AgentVoice: Open agent panel",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentvoice.ask",
        "title": "AgentVoice: Ask the agent…",
        "icon": "$(send)"
      },
      {
        "command": "agentvoice.sendSelection",
        "title": "AgentVoice: Send selection to agent"
      },
      {
        "command": "agentvoice.sendFile",
        "title": "AgentVoice: Send active file to agent"
      },
      {
        "command": "agentvoice.sendDiagnostics",
        "title": "AgentVoice: Send file diagnostics to agent"
      },
      {
        "command": "agentvoice.useWorkspaceAsProject",
        "title": "AgentVoice: Use this workspace as the active project"
      },
      {
        "command": "agentvoice.pickProject",
        "title": "AgentVoice: Switch project"
      },
      {
        "command": "agentvoice.pickModel",
        "title": "AgentVoice: Choose model / effort"
      },
      {
        "command": "agentvoice.pickPermissionMode",
        "title": "AgentVoice: Permission mode"
      },
      {
        "command": "agentvoice.newSession",
        "title": "AgentVoice: New agent session (fresh thread)"
      },
      {
        "command": "agentvoice.stopAgent",
        "title": "AgentVoice: Stop the agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentvoice.openDiff",
        "title": "AgentVoice: Open diff",
        "icon": "$(diff)"
      },
      {
        "command": "agentvoice.showDiffAll",
        "title": "AgentVoice: Show all changes (patch)"
      },
      {
        "command": "agentvoice.revert",
        "title": "AgentVoice: Revert agent changes (stash)"
      },
      {
        "command": "agentvoice.refresh",
        "title": "AgentVoice: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentvoice.answerApproval",
        "title": "AgentVoice: Answer pending approval",
        "icon": "$(bell)"
      },
      {
        "command": "agentvoice.markAllRead",
        "title": "AgentVoice: Mark transcript as read",
        "icon": "$(check-all)"
      },
      {
        "command": "agentvoice.statusMenu",
        "title": "AgentVoice: Status menu"
      },
      {
        "command": "agentvoice.selectSession",
        "title": "AgentVoice: Continue this session"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "agentvoice.sendSelection",
          "when": "editorHasSelection",
          "group": "agentvoice@1"
        },
        {
          "command": "agentvoice.sendFile",
          "group": "agentvoice@2"
        }
      ],
      "view/title": [
        {
          "command": "agentvoice.ask",
          "when": "view == agentvoice.panel",
          "group": "navigation@1"
        },
        {
          "command": "agentvoice.stopAgent",
          "when": "view == agentvoice.panel",
          "group": "navigation@2"
        },
        {
          "command": "agentvoice.markAllRead",
          "when": "view == agentvoice.panel",
          "group": "navigation@3"
        },
        {
          "command": "agentvoice.refresh",
          "when": "view == agentvoice.changes || view == agentvoice.sessions",
          "group": "navigation"
        },
        {
          "command": "agentvoice.showDiffAll",
          "when": "view == agentvoice.changes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agentvoice.openDiff",
          "when": "view == agentvoice.changes && viewItem == file",
          "group": "inline"
        },
        {
          "command": "agentvoice.selectSession",
          "when": "view == agentvoice.sessions && viewItem == session",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "agentvoice.openDiff",
          "when": "false"
        },
        {
          "command": "agentvoice.selectSession",
          "when": "false"
        },
        {
          "command": "agentvoice.statusMenu",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentvoice.sendSelection",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorHasSelection"
      },
      {
        "command": "agentvoice.ask",
        "key": "ctrl+alt+shift+a",
        "mac": "cmd+alt+shift+a"
      }
    ],
    "configuration": {
      "title": "AgentVoice",
      "properties": {
        "agentvoice.bridgeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Bridge origin. The bridge runs on this machine (loopback); use the test port (default 5089) when running `npm run dev`."
        },
        "agentvoice.autoRegisterWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "On connect, make the first workspace folder the active project (registered as an ephemeral project if it is not in config.json)."
        },
        "agentvoice.prepareOnConnect": {
          "type": "boolean",
          "default": true,
          "description": "Register the bridge's MCP server with the active agent CLI when connecting (same step the phone app runs before a voice session)."
        },
        "agentvoice.readAloud": {
          "type": "string",
          "enum": [
            "off",
            "bridge",
            "browser"
          ],
          "enumDescriptions": [
            "Silent: the transcript brightens at reading pace.",
            "Play the bridge's configured text-to-speech provider (Config → Speech) in the panel.",
            "Use the editor's built-in speechSynthesis voices (availability depends on the OS)."
          ],
          "default": "off",
          "description": "How the agent's spoken lines are voiced at the desk."
        },
        "agentvoice.pacer": {
          "type": "boolean",
          "default": true,
          "description": "When nothing is playing, advance the read-along highlight at reading speed so unread text dims and read text brightens."
        },
        "agentvoice.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show permission prompts, questions and password requests as editor notifications (they always appear in the panel)."
        },
        "agentvoice.contextMaxChars": {
          "type": "number",
          "default": 12000,
          "description": "Maximum characters of editor content attached to a turn (selection / file / diagnostics)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies --allow-missing-repository -o agentvoice.vsix",
    "install:code": "code --install-extension agentvoice.vsix --force",
    "install:flatpak": "flatpak run com.visualstudio.code --install-extension \"$(pwd)/agentvoice.vsix\" --force",
    "install:cursor": "cursor --install-extension agentvoice.vsix --force",
    "test": "npm run build && node test/runTest.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.3.0",
    "esbuild": "^0.25.0",
    "glob": "^11.1.0",
    "mocha": "^11.8.0",
    "ovsx": "^1.1.1",
    "typescript": "~5.8.0"
  }
}
