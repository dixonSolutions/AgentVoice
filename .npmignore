# The published tarball is defined by the "files" allowlist in package.json.
# This file exists so npm does NOT fall back to .gitignore, which ignores
# dist/ and web/dist/ — exactly the build output the package must ship.
#
# Belt-and-braces denies for anything secret or machine-local that could
# otherwise be pulled in by a stray "files" entry.

.env
.env.*
!.env.example
*.pem
*.key
config.json
data/
logs/
*.log
*.db
*.sqlite
*.sqlite3
.claude/
.cursor/
node_modules/
*.tsbuildinfo
.angular/
*.vsix

# The Vosk wake-word model is 41 MB of downloadable weights, not code. Shipping
# it would more than double the tarball for a feature that is off until someone
# turns it on. `agentvoice prepare-vosk` fetches it on demand.
web/dist/vosk/model.tar.gz
web/public/vosk/model.tar.gz
