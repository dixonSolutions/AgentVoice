# AgentVoice — Environment Variables
# Copy to .env, fill in values. Keep .env chmod 600. NEVER commit it.
# Secrets and machine-specific paths only. Voice preferences live in config.json.

# ── App auth ─────────────────────────────────────────────────────────────────
APP_TOKEN=                      # high-entropy shared secret
                                # generate: openssl rand -base64 32

# ── Voice provider keys (set only what you use — viability is auto-detected) ─
OPENAI_API_KEY=                 # OpenAI (Codex CLI + speech-to-text)
# GEMINI_API_KEY=               # Google Gemini Live + speech-to-text
# ANTHROPIC_API_KEY=            # Anthropic Claude voice
# AWS_ACCESS_KEY_ID=            # Amazon Bedrock (key name from console)
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1          # optional; defaults to us-east-1

# ── Speech providers (both directions) ──────────────────────────────────────
# Set only the ones you select in Config → Speech, or add them from the web app
# instead of editing this file. The self-hosted server needs no key at all.
# Each key serves both listening and speaking where the vendor does both.
# See docs/29-speech-to-text-providers.md and docs/30-speech-output-providers.md.
# GROQ_API_KEY=                 # Whisper large-v3 in, PlayAI voices out — fastest hosted
# DEEPGRAM_API_KEY=             # Deepgram Nova-3 in, Aura-2 voices out
# ELEVENLABS_API_KEY=           # ElevenLabs Scribe in, its voices out
# OPENROUTER_API_KEY=           # audio-capable chat models via OpenRouter

# ── Web Push (PWA background notifications) ─────────────────────────────────
# Generate: bash scripts/gen-vapid-keys.sh
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com

# ── Apple Push (native iOS app — optional until TestFlight build) ───────────
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_PATH=./AuthKey_XXXXX.p8
# APNS_BUNDLE_ID=com.cursorvoice.app
# APNS_PRODUCTION=false

# ── Bootstrap paths / bind (non-secret but machine-specific) ─────────────────
PORT=8787
CONFIG_PATH=./config.json
DB_PATH=./data/state.db
