{
  "settings": {
    "runMode": "test",
    "runModes": {
      "test": {
        "backendPort": 5089,
        "webPort": 4200
      },
      "serve": {
        "backendPort": 1234,
        "webPort": 5671,
        "publicBaseUrl": "https://your-machine.tailnet-name.ts.net"
      }
    },
    "workflow": {
      "default": "agent_native",
      "llmIntelligence": {
        "llm": {
          "provider": "bedrock",
          "model": "us.anthropic.claude-sonnet-4-20250514-v1:0",
          "region": "us-east-1",
          "maxTokens": 4096
        },
        "memory": {
          "maxTurns": 10,
          "keepTurns": 4,
          "summarySentences": 3
        },
        "readOutputMaxChars": 8000,
        "audio": {
          "preferWebkit": true,
          "ttsProvider": "browser",
          "pollyVoiceId": "Joanna",
          "pollyEngine": "neural",
          "transcribeModel": "speech_foundation_model",
          "transcribeLanguageMode": "fixed",
          "transcribeLanguageCode": "en-US",
          "transcribeLanguageOptions": "en-US,es-US,fr-FR,de-DE",
          "transcribePartialResultsStabilization": true,
          "transcribePartialResultsStability": "high"
        }
      }
    },
    "voice": {
      "wakeWords": {
        "start": "cursor listen",
        "end": "cursor send",
        "cancel": "cancel",
        "wakeConfidenceThreshold": 0.45
      },
      "turnSubmit": {
        "silenceMs": 700,
        "vadEnabled": true
      },
      "tts": {
        "agentVoiceEnabled": true,
        "errorSoundEnabled": true,
        "errorSpeakEnabled": true,
        "webkit": {
          "rate": 1.02,
          "pitch": 1,
          "volume": 1,
          "lang": "en-US"
        }
      },
      "touchControls": "when_muted",
      "wakeWordsEnabled": true,
      "defaultMicMuted": false,
      "workerPollTimeoutMs": 25000
    },
    "defaultMode": "agent",
    "defaultActiveModel": "auto",
    "maxConcurrentJobs": 1,
    "jobTimeoutMs": 600000,
    "planFirst": false,
    "preRunFlags": [
      "--force",
      "--trust"
    ],
    "modelCacheTtlMs": 3600000,
    "narratorEnabled": true,
    "narratorCadenceMs": 15000,
    "narratorMaxBufferEvents": 50,
    "ghostKillEnabled": true,
    "logLevel": "info",
    "userName": "Alex",
    "serve": {
      "branch": "main"
    }
  },
  "projects": [
    {
      "name": "cursorvoice",
      "path": "/home/eva/Projects/SideProjects/CursorVoice",
      "aliases": [
        "agent voice",
        "agentvoice",
        "cursor voice",
        "the voice project"
      ],
      "description": "AgentVoice \u2014 self-hosted voice bridge",
      "enabled": true
    }
  ],
  "_comment_projects": "Run: node scripts/apply-projects-registry.mjs \u2014 merges config/projects.registry.json for all ~/Projects entries"
}
