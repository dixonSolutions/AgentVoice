[Unit]
Description=AgentVoice Bridge
After=network-online.target fix-dns.service tailscaled.service
Wants=network-online.target fix-dns.service

[Service]
Type=simple
User=agentvoice
WorkingDirectory=/opt/agentvoice
Environment=HOME=/home/agentvoice
EnvironmentFile=/opt/agentvoice/.env
ExecStart=/usr/bin/node /opt/agentvoice/dist/index.js
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
# Adjust ReadWritePaths to include every allowlisted project workspace.
# The bridge data dir, its log dir (session logs + transcripts, see
# docs/33-logging.md) and the project workspaces are the only writable locations.
ReadWritePaths=/opt/agentvoice/data /opt/agentvoice/logs /home/projects
PrivateTmp=true

[Install]
WantedBy=multi-user.target
